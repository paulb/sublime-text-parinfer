{
  // When true, Parinfer will attempt to auto-detect lisp syntax for unsaved files.
  // Must be paired with "default_syntax". No default is provided for this.
  // If "default_syntax" is not configured, auto-detection will not enable Parinfer.
  "auto_detect": false,
  "file_extensions": [
    ".clj",
    ".cljs",
    ".cljc",
    ".edn",
    ".lfe",
    ".rkt",
    ".janet"
  ],
  // When true, "Parinfer: Disable" turns Parinfer off for all open views and any
  // file opened or saved afterward, until Parinfer is enabled again or Sublime restarts.
  // When false, disabling only affects the current view.
  "global_toggle": false,
  "run_paren_mode_when_file_opened": false
}
